# Anthropic (Claude) API
ANTHROPIC_API_KEY=
# Model used by the Layer 2 classifier (src/lib/guardrails/classify.ts) and
# the Tier 3 SQL generator (src/lib/text2sql/tier3.ts). Defaults to
# "claude-sonnet-5" in code if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres — app_runtime role (SELECT-only on sem.*/ont.*), see
# db/ddl/005_roles.sql and src/lib/db/client.ts.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pharmasentinel
PGUSER=app_runtime
PGPASSWORD=

# TODO(tier4): a second role/connection (e.g. app_runtime_tier4, SELECT-only
# on raw faers.*/ct.* tables) is not yet wired — see the tier4Pool TODO in
# src/lib/db/client.ts. Once it lands it will need its own PG* env vars
# here (e.g. PGUSER_TIER4 / PGPASSWORD_TIER4).
