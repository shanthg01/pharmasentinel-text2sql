# Anthropic (Claude) API
ANTHROPIC_API_KEY=
# Model used by the Layer 2 classifier (src/lib/guardrails/classify.ts) and
# the Tier 3 SQL generator (src/lib/text2sql/tier3.ts). Defaults to
# "claude-sonnet-5" in code if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres — app_runtime role (SELECT-only on sem.*/ont.*), see
# db/ddl/005_roles.sql and src/lib/db/client.ts.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pharmasentinel
PGUSER=app_runtime
PGPASSWORD=

# Tier 4's separate connection — app_runtime_tier4 role (adds SELECT on raw
# faers.*/ct.* tables, see db/ddl/005_roles.sql). Same host/port/database as
# above, only the role differs. Both fall back to sensible local-dev
# defaults if unset (PGUSER_TIER4 -> "app_runtime_tier4",
# PGPASSWORD_TIER4 -> PGPASSWORD) so this works against db/docker-compose.yml
# out of the box; set both explicitly for a real deployment.
PGUSER_TIER4=app_runtime_tier4
PGPASSWORD_TIER4=
