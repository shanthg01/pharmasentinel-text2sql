# Copy this file to db/.env and adjust before running docker compose.
# `docker compose -f db/docker-compose.yml --env-file db/.env up -d`
#
# These map straight onto the postgres:16 image's standard bootstrap
# variables (see https://hub.docker.com/_/postgres) -- they only take
# effect the *first* time the named volume is initialized. If you change
# them after the volume already exists you must recreate the volume or
# change the password via SQL (ALTER ROLE) instead.

# Superuser role created by the postgres image on first init.
POSTGRES_USER=pharmasentinel

# CHANGE THIS. Never commit a real password -- db/.env is expected to be
# gitignored. This placeholder is fine for local dev only.
POSTGRES_PASSWORD=changeme

# Default database name. All DDL in db/ddl/ assumes this database.
POSTGRES_DB=pharmasentinel

# Host-side port Postgres is published on (container-side is always 5432).
# Default is 5439, not 5432 -- avoids colliding with any other local
# Postgres container already bound to the default port on this machine.
POSTGRES_HOST_PORT=5439
